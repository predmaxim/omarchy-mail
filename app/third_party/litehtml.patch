+bool litehtml::line_box::is_fixed_box(const std::shared_ptr<element>& el)
+{
+    if(el->is_text() || el->is_break())
+    {
+        return false;
+    }
+    const css_length& width = el->css().get_width();
+    if(!width.is_predefined())
+    {
+        const css_length& max_width = el->css().get_max_width();
+        return width.units() != css_units_percentage ||
+               (!max_width.is_predefined() && max_width.units() != css_units_percentage);
+    }
+    return el->is_replaced() || std::none_of(el->children().begin(), el->children().end(), [](const element::ptr& c) {
+               return !c->is_white_space() && !is_fixed_box(c);
+           });
+}
