+bool litehtml::line_box::is_glue(const std::shared_ptr<element>& el)
+{
+    if(el->is_space())
+    {
+        return true;
+    }
+    if(!el->is_text())
+    {
+        return false;
+    }
+    std::string text;
+    el->get_text(text);
+    for(size_t i = 0; i < text.size(); i += 2)
+    {
+        if(text.compare(i, 2, "\xC2\xA0") != 0)
+        {
+            return false;
+        }
+    }
+    return !text.empty();
+}
