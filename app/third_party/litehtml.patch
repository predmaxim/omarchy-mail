+bool litehtml::el_text::may_cut(bool min_content) const
+{
+    if(is_white_space())
+    {
+        return false;
+    }
+    const white_space   ws = css().get_white_space();
+    const word_break    wb = css().get_word_break();
+    const overflow_wrap ow = css().get_overflow_wrap();
+    return (ws == white_space_normal || ws == white_space_pre_wrap || ws == white_space_pre_line) &&
+           (wb == word_break_break_all || wb == word_break_break_word || ow == overflow_wrap_anywhere ||
+            (!min_content && ow == overflow_wrap_break_word));
+}
+
+litehtml::pixel_t litehtml::el_text::widest_cluster()
+{
+    const uint_ptr font = parent() ? parent()->css().get_font() : 0;
+    if(!font)
+    {
+        return m_size.width;
+    }
+    std::vector<std::size_t> ends;
+    get_document()->container()->grapheme_ends(m_text.c_str(), ends);
+    pixel_t     widest = 0;
+    std::size_t from   = 0;
+    for(std::size_t end : ends)
+    {
+        widest = std::max(widest, get_document()->container()->text_width(m_text.substr(from, end - from).c_str(), font));
+        from   = end;
+    }
+    return widest;
+}
+
+// shortcut: the cuts are measured untransformed and each piece is transformed on its own (text-transform: capitalize
+// would capitalise a piece); qlitehtml transforms nothing. Measure the transformed word if a container needs it
+std::vector<litehtml::element::ptr> litehtml::el_text::cut(pixel_t room, pixel_t width, bool keep_one)
+{
+    std::vector<element::ptr> pieces;
+    const element::ptr        el_parent = parent();
+    const uint_ptr            font      = el_parent ? el_parent->css().get_font() : 0;
+    if(!font)
+    {
+        return pieces;
+    }
+    document_container*      container = get_document()->container();
+    std::vector<std::size_t> ends;
+    container->grapheme_ends(m_text.c_str(), ends);
+    std::vector<std::size_t> cuts; // where each piece after the first starts
+    std::size_t              from = 0, fits = 0; // the piece being filled starts at `from`; its clusters up to `fits` fit
+    for(std::size_t end : ends)
+    {
+        if(container->text_width(m_text.substr(from, end - from).c_str(), font) > (cuts.empty() ? room : width))
+        {
+            if(fits > from)
+            {
+                cuts.push_back(fits);
+                from = fits;
+            } else if(cuts.empty() && !keep_one)
+            {
+                return pieces;
+            }
+        }
+        fits = end;
+    }
+    if(cuts.empty())
+    {
+        return pieces;
+    }
+    if(m_whole_text.empty())
+    {
+        m_whole_text        = m_text;
+        m_whole_transformed = m_transformed_text;
+        m_whole_size        = m_size;
+    }
+    element::ptr after = shared_from_this();
+    for(std::size_t i = 0; i < cuts.size(); i++)
+    {
+        const std::size_t end   = i + 1 < cuts.size() ? cuts[i + 1] : m_text.size();
+        auto              piece = std::make_shared<el_text>(m_text.substr(cuts[i], end - cuts[i]).c_str(), get_document());
+        piece->m_piece          = true;
+        el_parent->insert_child_after(after, piece);
+        piece->compute_styles(false);
+        pieces.push_back(piece);
+        after = piece;
+    }
+    m_text.resize(cuts.front());
+    compute_styles(false);
+    return pieces;
+}
+
+void litehtml::el_text::join()
+{
+    if(!m_whole_text.empty())
+    {
+        m_text             = std::move(m_whole_text);
+        m_transformed_text = std::move(m_whole_transformed);
+        m_size             = m_whole_size;
+        m_whole_text.clear();
+    }
+}
