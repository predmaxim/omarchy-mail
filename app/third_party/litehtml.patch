+void litehtml::document_container::grapheme_ends(const char* text, std::vector<std::size_t>& ends)
+{
+    for(std::size_t i = 1; text[i - 1]; i++)
+    {
+        if((text[i] & 0xC0) != 0x80) // not a UTF-8 continuation byte: a code point ends before it
+        {
+            ends.push_back(i);
+        }
+    }
+}
