+    const std::function<QRect(const litehtml::element::ptr &)> placement = [&](const litehtml::element::ptr &e) {
+        QRect r = toQRect(e->get_placement());
+        for (const litehtml::element::ptr &child : e->children())
+            r = r.united(placement(child));
+        return r;
+    };
+    for (const litehtml::element::ptr &a : d->m_document->root()->select_all("a[href]"))
+        result.append({d->resolveUrl(QString::fromUtf8(a->get_attr("href")), d->m_baseUrl), placement(a)});
