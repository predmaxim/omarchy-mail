+// litehtml breaks a line between any two words that touch, never inside one: a word of more than 30
+// characters (a URL, a key) goes out in pieces, joined the text stays the same — cut after / ? & = # - _ .
+// and every 10 characters without one. ponytail: such a word breaks wherever the line ends, not only when it
+// can't fit a line of its own, and up to 9 characters short of the end; exact needs litehtml's line layout.
+// Only its first 10 000 characters are cut, the rest stays one piece past the right edge: a 1 MiB word
+// (inline base64) in 100 000 pieces took 8 s, and a later letter waits for the layout
+void DocumentContainerPrivate::split_text(const char *text,
+                                          const std::function<void(const char *)> &on_word,
+                                          const std::function<void(const char *)> &on_space)
+{
+    const auto urlBreak = [](QChar c) { return QStringView(u"/?&=#-_.").contains(c); };
+    litehtml::document_container::split_text(
+        text,
+        [&](const char *utf8) {
+            const QString word = QString::fromUtf8(utf8);
+            if (word.size() <= 30) {
+                on_word(utf8);
+                return;
+            }
+            QTextBoundaryFinder graphemes(QTextBoundaryFinder::Grapheme, word);
+            qsizetype from = 0;
+            int run = 0;
+            for (qsizetype at = graphemes.toNextBoundary(); at > 0; at = graphemes.toNextBoundary()) {
+                const bool last = at == word.size() || at >= 10000;
+                if (!last && ++run < 10 && !(urlBreak(word.at(at - 1)) && !urlBreak(word.at(at))))
+                    continue;
+                on_word(word.mid(from, last ? -1 : at - from).toUtf8().constData());
+                if (last)
+                    return;
+                from = at;
+                run = 0;
+            }
+        },
+        on_space);
+}
